{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "icust-angular-latest-test": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "allowedCommonJsDependencies": [
              "rxjs",
              "rxjs-compat",
              "core-js",
              "tinycolor2",
              "highlight.js",
              "zrender/lib/vml/vml",
              "zrender/lib/svg/svg",
              "contra/emitter",
              "crossvent",
              "@mattlewis92/dom-autoscroller",
              "dom-plane",
              "dom-set",
              "moment",
              "crypto-js",
              "highcharts-angular",
              "highcharts",
              "raf",
              "rgbcolor",
              "exceljs",
              "file-saver",
              "jspdf-autotable",
              "sweetalert2",
              "@tensorflow/tfjs-core",
              "fusioncharts",
              "face-api.js"
            ],
            "outputPath": "dist",
            "index": "src/index.html",
            "main": "src/main.ts",
            "polyfills": "src/polyfills.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": ["src/favicon.ico", "src/assets"],
            "styles": [
              "src/assets/styles/app.scss",
              "node_modules/ngx-toastr/toastr.css",
              "node_modules/ngx-spinner/animations/square-loader.css",
              "node_modules/keen-slider/keen-slider.min.css",
              "node_modules/ngx-spinner/animations/square-jelly-box.css",
              "node_modules/@onerumango/icust-scss-library/dist/main.css",
              "node_modules/@angular/cdk/overlay-prebuilt.css"
            ],
            "scripts": []
          },
          "configurations": {
            "stanbic": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kb",
                  "maximumError": "9mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kb",
                  "maximumError": "9mb"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.stanbic.ts"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "buildOptimizer": false,
              "optimization": false,
              "vendorChunk": true,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            }
          },
          "defaultConfiguration": "stanbic"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "browserTarget": "icust-angular-latest-test:build:production"
            },
            "qa": {
              "browserTarget": "icust-angular-latest-test:build:qa"
            },
            "development": {
              "browserTarget": "icust-angular-latest-test:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "browserTarget": "icust-angular-latest-test:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": ["zone.js", "zone.js/testing"],
            "tsConfig": "tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "assets": ["src/favicon.ico", "src/assets"],
            "styles": ["src/styles.scss"],
            "scripts": []
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["src/**/*.ts", "src/**/*.html"]
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false,
    "schematicCollections": ["@angular-eslint/schematics"]
  }
}
