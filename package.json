{
  "name": "icust",
  "version": "14.2.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --ssl true --ssl-cert src/assets/certificates/auth_service.crt --ssl-key src/assets/certificates/auth_service.key --port 4210",
    "build": "ng build --c=stanbic",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "prepare": "husky install",
    "lint": "eslint --ext .ts,.js,.tsx,.html src/",
    "lint:fix": "eslint -- --ext .ts,.js,.tsx,.html src/ --fix --quiet",
    "pretty": "prettier --write \"src/**/*.{ts,js,jsx,mjs,cjs,tsx,json,html,css,scss}\"",
    "install:lib": "npm install @onerumango/icust-element-library@latest @onerumango/utils@latest",
    "tsc": "tsc"
  },
  "lint-staged": {
    "*.{ts,js,jsx,mjs,cjs,tsx}": [
      "npm run pretty"
    ],
    "*.{json,html,css,scss}": [
      "npm run pretty"
    ]
  },
  "private": true,
  "dependencies": {
    "@angular-slider/ngx-slider": "^16.0.0",
    "@angular/animations": "^16.2.12",
    "@angular/cdk": "^16.2.14",
    "@angular/common": "^16.2.12",
    "@angular/compiler": "^16.2.12",
    "@angular/core": "^16.2.12",
    "@angular/forms": "^16.2.12",
    "@angular/localize": "^16.2.12",
    "@angular/material": "^16.2.14",
    "@angular/material-moment-adapter": "^16.2.14",
    "@angular/platform-browser": "^16.2.12",
    "@angular/platform-browser-dynamic": "^16.2.12",
    "@angular/router": "^16.2.12",
    "@juggle/resize-observer": "^3.4.0",
    "@ngbracket/ngx-layout": "^16.1.3",
    "@ngrx/effects": "^16.3.0",
    "@ngrx/store": "^16.3.0",
    "@ngx-translate/core": "^16.0.3",
    "@ngx-translate/http-loader": "^16.0.0",
    "@onerumango/icust-element-library": "file:onerumango-icust-element-library-latest.tgz",
    "@onerumango/utils": "file:onerumango-utils-latest.tgz",
    "cleave.js": "^1.6.0",
    "crypto-js": "^4.2.0",
    "decimal.js": "^10.4.3",
    "exceljs": "^4.3.0",
    "face-api.js": "^0.22.2",
    "file-saver": "^2.0.5",
    "highcharts": "^10.3.3",
    "inputmask": "^5.0.8",
    "keen-slider": "^6.8.6",
    "moment": "^2.29.4",
    "ng-otp-input": "^1.9.3",
    "ngx-image-cropper": "^6.3.4",
    "ngx-toastr": "^19.0.0",
    "ngx-webcam": "^0.4.1",
    "perfect-scrollbar": "^1.5.5",
    "rxjs": "^7.8.0",
    "swiper": "^8.4.5",
    "xlsx": "^0.18.5",
    "zone.js": "~0.13.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^16.2.16",
    "@angular-eslint/builder": "16.3.1",
    "@angular-eslint/eslint-plugin": "16.3.1",
    "@angular-eslint/eslint-plugin-template": "16.3.1",
    "@angular-eslint/schematics": "16.3.1",
    "@angular-eslint/template-parser": "16.3.1",
    "@angular/cli": "~16.2.16",
    "@angular/compiler-cli": "^16.2.12",
    "@commitlint/config-conventional": "^19.8.1",
    "@types/crypto-js": "^4.2.2",
    "@types/file-saver": "^2.0.7",
    "@types/inputmask": "^5.0.7",
    "@types/jasmine": "~4.0.0",
    "@types/node": "^22.9.0",
    "@typescript-eslint/eslint-plugin": "5.62.0",
    "@typescript-eslint/parser": "5.62.0",
    "eslint": "^8.51.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "husky": "^8.0.0",
    "jasmine-core": "~4.3.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.0.0",
    "prettier": "^3.4.2",
    "typescript": "^4.9.5"
  },
  "browser": {
    "fs": false,
    "path": false,
    "os": false
  }
}
